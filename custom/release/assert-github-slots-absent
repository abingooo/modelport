#!/bin/sh
set -eu

remote="${1:?git remote is required}"
tag="${2:?release tag is required}"
repository="${3:?GitHub repository is required}"
api_url="${GITHUB_API_URL:-https://api.github.com}"

printf '%s\n' "${tag}" | grep -Eq '^custom-v[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || {
  echo "Invalid ModelPort release tag: ${tag}" >&2
  exit 1
}
printf '%s\n' "${repository}" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || {
  echo "Invalid GitHub repository: ${repository}" >&2
  exit 1
}
[ -n "${GH_TOKEN:-}" ] || { echo 'GH_TOKEN is required for release preflight' >&2; exit 1; }

if git ls-remote --exit-code --tags "${remote}" "refs/tags/${tag}" >/dev/null 2>&1; then
  echo "Tag ${tag} already exists and will not be overwritten" >&2
  exit 1
else
  git_status=$?
  if [ "${git_status}" -ne 2 ]; then
    echo "Unable to establish whether tag ${tag} exists (git exit ${git_status})" >&2
    exit 1
  fi
fi

release_url="${api_url%/}/repos/${repository}/releases/tags/${tag}"
if ! http_status="$({
  printf 'header = "Accept: application/vnd.github+json"\n'
  printf 'header = "Authorization: Bearer %s"\n' "${GH_TOKEN}"
  printf 'header = "X-GitHub-Api-Version: 2022-11-28"\n'
} | curl --config - --silent --show-error --location --output /dev/null \
  --write-out '%{http_code}' --connect-timeout 10 --max-time 30 \
  --proto '=https' --proto-redir '=https' "${release_url}")"; then
  echo "Unable to query the GitHub Release slot for ${tag}" >&2
  exit 1
fi

case "${http_status}" in
  404)
    ;;
  200)
    echo "Release ${tag} already exists and will not be overwritten" >&2
    exit 1
    ;;
  *)
    echo "Unexpected GitHub API status ${http_status} while checking ${tag}" >&2
    exit 1
    ;;
esac
