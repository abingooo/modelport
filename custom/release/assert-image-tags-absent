#!/bin/sh
set -eu

[ "$#" -gt 0 ] || { echo 'At least one image reference is required' >&2; exit 1; }

for ref in "$@"; do
  printf '%s\n' "${ref}" | grep -Eq '^ghcr\.io/abingooo/modelport:(custom-v[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+|sha-[0-9a-f]{40})$' || {
    echo "Invalid ModelPort image tag: ${ref}" >&2
    exit 1
  }

  if inspect_error="$(docker buildx imagetools inspect "${ref}" 2>&1)"; then
    echo "Image tag ${ref} already exists and will not be overwritten" >&2
    exit 1
  else
    inspect_status=$?
  fi

  if printf '%s\n' "${inspect_error}" | awk -v expected_ref="${ref}" '
    BEGIN {
      expected_ref = tolower(expected_ref)
      expected_manifest = expected_ref
      sub(/^ghcr\.io\//, "", expected_manifest)
      sub(/:/, "/manifests/", expected_manifest)
      expected_manifest = "ghcr.io/v2/" expected_manifest
    }
    {
      line = tolower($0)
      if (line ~ /^[[:space:]]*$/) next
      # Buildx currently reports a missing tag as
      #   ERROR: <ref>: not found
      # followed by a generic fatal-exit log line.  Match the reference
      # exactly so a token/authentication 404 cannot be mistaken for absence.
      if (line == "error: " expected_ref ": not found") {
        absent = 1
        next
      }
      if (line ~ /(^|:[[:space:]])manifest[[:space:]]+unknown[[:space:]]*$/) {
        absent = 1
        next
      }
      # Older/newer registry clients may expose the underlying HEAD status
      # instead of normalizing it to "<ref>: not found".
      if (index(line, expected_manifest) > 0 &&
          line ~ /(^|[^[:alnum:]_])head([^[:alnum:]_]|$)/ &&
          line ~ /(^|[^[:digit:]])404[[:space:]]+not[[:space:]]+found[[:space:]]*$/) {
        absent = 1
        next
      }
      if (line ~ /^time="[^"]+"[[:space:]]+level=fatal[[:space:]]+msg="exit status [0-9]+"[[:space:]]*$/) next
      unexpected = 1
      exit
    }
    END { if (unexpected || !absent) exit 1 }
  '; then
    continue
  fi

  echo "Unable to establish whether image tag ${ref} exists (inspect exit ${inspect_status})" >&2
  [ -z "${inspect_error}" ] || printf '%s\n' "${inspect_error}" >&2
  exit 1
done
